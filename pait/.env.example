ANTHROPIC_MOCK=true
ANTHROPIC_API_KEY=mock-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-mock
DATABASE_URL=postgres://postgres:postgres@localhost:5432/share_doc
REDIS_URL=redis://127.0.0.1:6379
COOKIE_SECRET=dev-cookie-secret-change-me
PORT=3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_HOSTED_DOMAIN=company.com
DOCUMENT_ACCESS_RULES='{"default":{"documents":[],"categories":[]}}'
SHAREPOINT_GRAPH_TENANT_ID=your-tenant-id
SHAREPOINT_GRAPH_CLIENT_ID=your-graph-client-id
SHAREPOINT_GRAPH_CLIENT_SECRET=your-graph-client-secret
SHAREPOINT_GRAPH_SITE_ID=your-site-id
SHAREPOINT_GRAPH_DRIVE_ID=your-drive-id
# Optional: scope document sync to a folder instead of the drive root.
# SHAREPOINT_GRAPH_ROOT_ITEM_ID=your-root-folder-item-id
